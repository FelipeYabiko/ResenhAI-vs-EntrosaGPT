# Copie para .env e ajuste. Nunca faça commit do .env.
# Estes valores são exemplos, não são segredos.

# Modo de demonstração: só aceita CNPJs de fixtures/cnpjs_demo.json
MODO_DEMO=true

# Banco de dados
DATABASE_URL=postgresql://usuario:senha@localhost:5432/credfacil

# Fontes públicas (hosts fixos)
CNPJ_API_BASE_URL=https://open.cnpja.com/office
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie
FONTES_TIMEOUT_MS=1200
CACHE_TTL_CNPJ_S=86400
CACHE_TTL_BCB_S=86400

# Webhook opcional para a matriz (deixe vazio para usar só SSE)
WEBHOOK_MATRIZ_URL=
WEBHOOK_SECRET=troque-este-valor

# Web (variáveis NEXT_PUBLIC_* são públicas)
NEXT_PUBLIC_API_URL=http://localhost:8000
